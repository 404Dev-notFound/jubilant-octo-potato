# ==============================================================================
# CodeCollab Environment Configuration Template
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# Application Environment ('production' | 'development' | 'test')
NODE_ENV=production

# Server Port (default: 3000)
PORT=3000

# Database Connection URL (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=<schema>
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5432/codecollab?schema=public
POSTGRES_PASSWORD=your_secure_postgres_password

# JWT Authentication Secret (Must be a strong random secret string in production)
JWT_SECRET=your_production_jwt_secret_minimum_32_characters_long

# Google OAuth Client ID (Optional for Google Sign-In)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# GitHub OAuth App Credentials (Optional for GitHub Sign-In)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Allowed CORS Origins (Comma-separated for multiple origins, or '*' for open access in dev)
CORS_ORIGIN=*

